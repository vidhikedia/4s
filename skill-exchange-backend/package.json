{
  "name": "campus-skill-exchange-backend",
  "version": "1.0.0",
  "description": "Backend for the Campus Skill Exchange DBMS project (zero dependencies, Node 22.13+)",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "seed": "node seed.js",
    "start": "node server.js",
    "test": "node test.js",
    "test:pg": "node -e \"process.env.TEST_PG='pglite'; require('./test.js')\""
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17"
  }
}
