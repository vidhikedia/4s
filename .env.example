# =============================================================================
# Campus Skill Exchange - Environment Variables Template
# All values below are FAKE placeholders. Replace with your actual deployment values.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend Settings (Vercel)
# -----------------------------------------------------------------------------
# The full URL pointing to your Render backend API.
# Note: Must include the /api prefix without a trailing slash.
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

# -----------------------------------------------------------------------------
# Backend Settings (Render Web Service)
# -----------------------------------------------------------------------------
# Port number for the backend HTTP server (Render auto-injects this)
PORT=3000

# PostgreSQL connection string from Neon (with SSL enabled)
# For local development with SQLite, leave DATABASE_URL unset/empty.
DATABASE_URL=postgresql://demo_user:demo_secret_password_123@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Strong secret key for signing HMAC-SHA256 JWT tokens (required in production)
JWT_SECRET=demo_jwt_secret_phrase_change_to_a_secure_random_string_in_production

# CORS origin allowing requests from your Vercel frontend app
FRONTEND_ORIGIN=https://your-frontend-app.vercel.app

# Trust reverse proxy X-Forwarded-For headers for accurate client IP rate limiting
TRUST_PROXY=true

# Set to 'true' to auto-seed demo campus data into a fresh Neon database upon initial deployment
SEED_DEMO=false

# Node environment mode ('development' or 'production')
NODE_ENV=production
